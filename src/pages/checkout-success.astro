---
import ShopLayout from "../layouts/ShopLayout.astro";
---

<ShopLayout title="Betaling gelukt">
  <main class="cart-shell">
    <h1 class="shop-title">Betaling gelukt</h1>

    <div class="cart-panel">
      <div class="cart-panel-inner">
        <p>Bedankt voor je bestelling.</p>
        <p class="muted">
          Je betaling is ontvangen. Je krijgt een email met de info over jouw bestelling!
        </p>
        <br />
        <a class="shop-button" href="/">Terug naar shop</a>
      </div>
    </div>
  </main>

  <script>
    localStorage.removeItem("cart");
    localStorage.removeItem("checkoutDraft");

    const sessionId = new URLSearchParams(window.location.search).get("session_id");

    if (sessionId) {
      fetch("/api/checkout/confirm", {
        method: "POST",
        headers: {
          "content-type": "application/json",
        },
        body: JSON.stringify({ sessionId }),
      }).catch((error) => {
        console.error("Checkout confirm request mislukt", error);
      });
    }
  </script>
</ShopLayout>
