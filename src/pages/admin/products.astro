      productsRoot.querySelectorAll("[data-delete-variant]").forEach((button) => {
        button.addEventListener("click", async () => {
          const variantId = button.getAttribute("data-delete-variant");

          if (!variantId) {
            return;
          }

          const confirmed = window.confirm("Deze variant verwijderen?");
          if (!confirmed) {
            return;
