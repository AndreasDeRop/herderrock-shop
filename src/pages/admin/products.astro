          }

          const imageUrlInput = productsRoot.querySelector(`[data-new-image-url="${productId}"]`);
          const altInput = productsRoot.querySelector(`[data-new-image-alt="${productId}"]`);
          const orderInput = productsRoot.querySelector(`[data-new-image-order="${productId}"]`);

          if (
            !(imageUrlInput instanceof HTMLInputElement) ||
            !(altInput instanceof HTMLInputElement) ||
            !(orderInput instanceof HTMLInputElement)
