      productsRoot.querySelectorAll("[data-save-description]").forEach((button) => {
        button.addEventListener("click", async () => {
          const productId = button.getAttribute("data-save-description");
          const input = productsRoot.querySelector(
            `[data-description-input="${productId}"]`,
          );

          if (!productId || !(input instanceof HTMLTextAreaElement)) {
