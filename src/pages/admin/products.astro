      productsRoot.querySelectorAll("[data-delete-product]").forEach((button) => {
        button.addEventListener("click", async () => {
          const productId = button.getAttribute("data-delete-product");

          if (!productId) {
            return;
          }

          const confirmed = window.confirm(
            "Dit product echt verwijderen? Alle varianten en afbeeldingen zonder bestellingen worden mee verwijderd.",
          );

          if (!confirmed) {
            return;
          }

          const ok = await deleteProduct(productId, button);

          if (ok) {
            await loadProductsAdmin();
          }
        });
      });

      productsRoot.querySelectorAll("[data-add-variant]").forEach((button) => {
        button.addEventListener("click", async () => {
          const productId = button.getAttribute("data-add-variant");

          if (!productId) {
            return;
          }

          const labelInput = productsRoot.querySelector(`[data-new-label="${productId}"]`);
          const sizeInput = productsRoot.querySelector(`[data-new-size="${productId}"]`);
          const priceInput = productsRoot.querySelector(`[data-new-price="${productId}"]`);
          const stockInput = productsRoot.querySelector(`[data-new-stock="${productId}"]`);
          const kidsInput = productsRoot.querySelector(`[data-new-kids="${productId}"]`);

          if (
            !(labelInput instanceof HTMLInputElement) ||
            !(sizeInput instanceof HTMLInputElement) ||
            !(priceInput instanceof HTMLInputElement) ||
            !(stockInput instanceof HTMLInputElement) ||
            !(kidsInput instanceof HTMLSelectElement)
          ) {
            return;
          }

          const label = labelInput.value.trim();
          const size = sizeInput.value.trim();
          const euroValue = Number(priceInput.value);
          const stockQuantity = Number(stockInput.value);
          const isKids = kidsInput.value === "true";

          if (!label || !size) {
            alert("Label en maat zijn verplicht.");
            return;
          }

          if (!Number.isFinite(euroValue) || euroValue < 0) {
            alert("Prijs moet 0 of hoger zijn.");
            return;
          }

          if (!Number.isInteger(stockQuantity) || stockQuantity < 0) {
            alert("Stock moet een geheel getal van 0 of hoger zijn.");
            return;
          }

          const ok = await addVariant(
            {
              productId,
              label,
              size,
              color: "zwart",
              isKids,
              isActive: true,
              stockQuantity,
              priceCents: Math.round(euroValue * 100),
            },
            button
          );

          if (ok) {
            await loadProductsAdmin();
          }
        });
      });
    }

    function applyFiltersAndRender() {
      renderProducts(getFilteredProducts());
    }
async function addProduct(payload, buttonToDisable = null) {
  const accessToken = await getAccessToken();

  if (!accessToken) {
    window.location.href = "/admin/login";
    return false;
  }

  if (buttonToDisable instanceof HTMLButtonElement) {
    buttonToDisable.disabled = true;
  }

  const response = await fetch("/api/admin/products/add-product", {
    method: "POST",
    headers: {
      "content-type": "application/json",
      Authorization: `Bearer ${accessToken}`,
    },
    body: JSON.stringify(payload),
  });

  const result = await response.json().catch(() => null);

  if (buttonToDisable instanceof HTMLButtonElement) {
    buttonToDisable.disabled = false;
  }

  if (!response.ok) {
    alert(result?.error || "Kon product niet aanmaken.");
    return false;
  }

  return true;
}
    async function loadProductsAdmin() {
      const accessToken = await getAccessToken();

      if (!accessToken) {
        window.location.href = "/admin/login";
        return;
      }

      if (productsRoot) {
        productsRoot.innerHTML = "";
      }

      if (adminStatus) {
        adminStatus.textContent = "Admin check bezig...";
      }

      const meResponse = await fetch("/api/admin/me", {
        headers: {
          Authorization: `Bearer ${accessToken}`,
        },
      });

      if (meResponse.status === 401) {
        await supabase.auth.signOut();
        window.location.href = "/admin/login";
        return;
      }

      if (meResponse.status === 403) {
        if (adminStatus) {
          adminStatus.textContent = "Je account heeft geen adminrechten.";
        }
        return;
      }

      if (!meResponse.ok) {
        let errorText = `Admin check mislukt (${meResponse.status}).`;

        try {
          const err = await meResponse.json();
          if (err?.error) {
            errorText += ` ${err.error}`;
          }
        } catch {}

        if (adminStatus) {
          adminStatus.textContent = errorText;
        }
        return;
      }

      const meResult = await meResponse.json();

      if (adminStatus) {
        adminStatus.textContent = `Ingelogd als ${meResult.user.email}`;
      }

      const productsResponse = await fetch("/api/admin/products", {
        headers: {
          Authorization: `Bearer ${accessToken}`,
        },
      });

      if (!productsResponse.ok) {
        let errorText = `Kon producten niet laden (${productsResponse.status}).`;

        try {
          const err = await productsResponse.json();
          if (err?.error) {
            errorText += ` ${err.error}`;
          }
        } catch {}

        if (productsRoot) {
          productsRoot.innerHTML = `
            <div class="cart-panel">
              <div class="cart-panel-inner">${escapeHtml(errorText)}</div>
            </div>
          `;
        }
        return;
      }

      const { products } = await productsResponse.json();
      allProducts = products || [];
      applyFiltersAndRender();
    }

    if (logoutButton) {
      logoutButton.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin/login";
      });
    }

    if (productSearch instanceof HTMLInputElement) {
      productSearch.addEventListener("input", applyFiltersAndRender);
    }
    if (createProductButton instanceof HTMLButtonElement) {
  createProductButton.addEventListener("click", async () => {
    if (
      !(newProductName instanceof HTMLInputElement) ||
      !(newProductSlug instanceof HTMLInputElement) ||
      !(newProductImage instanceof HTMLInputElement) ||
      !(newProductActive instanceof HTMLSelectElement) ||
      !(newProductDescription instanceof HTMLTextAreaElement) ||
      !(newProductCreateVariant instanceof HTMLSelectElement) ||
      !(newProductVariantLabel instanceof HTMLInputElement) ||
      !(newProductVariantSize instanceof HTMLInputElement) ||
      !(newProductVariantPrice instanceof HTMLInputElement) ||
      !(newProductVariantStock instanceof HTMLInputElement) ||
      !(newProductVariantKids instanceof HTMLSelectElement)
    ) {
      return;
    }

    const name = newProductName.value.trim();
    const slug = newProductSlug.value.trim();
    const imageUrl = newProductImage.value.trim();
    const description = newProductDescription.value.trim();
    const isActive = newProductActive.value === "true";

    const createFirstVariant = newProductCreateVariant.value === "true";
    const variantLabel = newProductVariantLabel.value.trim();
    const variantSize = newProductVariantSize.value.trim();
    const variantPriceEuro = Number(newProductVariantPrice.value);
    const variantStockQuantity = Number(newProductVariantStock.value);
    const variantIsKids = newProductVariantKids.value === "true";

    if (!name) {
      alert("Productnaam is verplicht.");
      return;
    }

    if (createFirstVariant) {
      if (!variantLabel || !variantSize) {
        alert("Voor de eerste variant zijn label en maat verplicht.");
        return;
      }

      if (!Number.isFinite(variantPriceEuro) || variantPriceEuro < 0) {
        alert("Variantprijs moet 0 of hoger zijn.");
        return;
      }

      if (!Number.isInteger(variantStockQuantity) || variantStockQuantity < 0) {
        alert("Variantstock moet een geheel getal van 0 of hoger zijn.");
        return;
      }
    }

    const ok = await addProduct(
      {
        name,
        slug,
        description,
        imageUrl,
        isActive,
        createFirstVariant,
        variantLabel,
        variantSize,
        variantColor: "zwart",
        variantIsKids,
        variantIsActive: true,
        variantStockQuantity,
        variantPriceCents: Math.round((Number.isFinite(variantPriceEuro) ? variantPriceEuro : 0) * 100),
      },
      createProductButton
    );

    if (ok) {
      newProductName.value = "";
      newProductSlug.value = "";
      newProductImage.value = "";
      newProductDescription.value = "";
      newProductActive.value = "true";
      newProductCreateVariant.value = "true";
      newProductVariantLabel.value = "";
      newProductVariantSize.value = "";
      newProductVariantPrice.value = "0.00";
      newProductVariantStock.value = "0";
      newProductVariantKids.value = "false";

      await loadProductsAdmin();
    }
  });
}
    supabase.auth.onAuthStateChange((_event, session) => {
      if (session?.access_token) {
        loadProductsAdmin();
      }
    });

    loadProductsAdmin();
  </script>
